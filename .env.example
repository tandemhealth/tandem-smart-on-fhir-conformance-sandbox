# Copy to .env and adjust. Every variable is optional; see src/smart_sandbox/config.py.

# URL your browser (and your EHR's OAuth redirect) uses to reach the sandbox.
SANDBOX_PUBLIC_BASE_URL=http://localhost:8090

# Where registrations and run reports are stored.
SANDBOX_DB_PATH=.run/smart-sandbox.sqlite3

# Allow http:// and loopback/LAN EHR endpoints (dev EHR on localhost or your
# network). Link-local/cloud-metadata ranges stay blocked. Keep the sandbox
# bound to 127.0.0.1 while this is on: anyone who can reach the port can
# register a client and drive requests from your machine.
SANDBOX_ALLOW_PRIVATE_NETWORK=true

# Optional: persist client secrets/tokens across restarts. Without it an
# ephemeral key is generated and you re-register after each restart.
# SANDBOX_SECRETS_KEY=
